# Hyrule forest theme: moss & lime panels, gauges run leaf green -> amber -> heart red

theme[main_bg]="#0a1f1b"
theme[main_fg]="#dfe8c4"
theme[title]="#eef3d6"
theme[hi_fg]="#c8df7c"
theme[selected_bg]="#29543d"
theme[selected_fg]="#eef3d6"
theme[inactive_fg]="#4d6b55"
theme[graph_text]="#a9c08a"
theme[meter_bg]="#1e3e31"
theme[proc_misc]="#7cc8b4"
theme[div_line]="#35694c"

# Box outlines
theme[cpu_box]="#9aca68"
theme[mem_box]="#7cc8b4"
theme[net_box]="#e6ad5c"
theme[proc_box]="#669b62"

# Gradients: low load stays green, high load turns heart red
theme[temp_start]="#9aca68"
theme[temp_mid]="#e6ad5c"
theme[temp_end]="#e0404f"

theme[cpu_start]="#9aca68"
theme[cpu_mid]="#e6ad5c"
theme[cpu_end]="#e0404f"

theme[free_start]="#35694c"
theme[free_mid]="#669b62"
theme[free_end]="#9aca68"

theme[cached_start]="#2f6f66"
theme[cached_mid]="#5fa89a"
theme[cached_end]="#7cc8b4"

theme[available_start]="#669b62"
theme[available_mid]="#9aca68"
theme[available_end]="#c8df7c"

theme[used_start]="#9aca68"
theme[used_mid]="#e6ad5c"
theme[used_end]="#e0404f"

theme[download_start]="#2f6f66"
theme[download_mid]="#7cc8b4"
theme[download_end]="#eef3c4"

theme[upload_start]="#8a3a52"
theme[upload_mid]="#d58aa6"
theme[upload_end]="#ff7a7f"

theme[process_start]="#9aca68"
theme[process_mid]="#e6ad5c"
theme[process_end]="#e0404f"
