# Ignore everything in ~/.config by default to prevent system state/caches from being committed
/*

# Always include this .gitignore file
!/.gitignore

# Whiltelist user customizations and dotfiles
!/hypr/
!/quickshell/
!/fish/
!/kitty/
!/gtk-3.0/
!/starship.toml
!/dolphinrc
!/pavucontrol.ini
!/wofi/
!/btop/
!/qt6ct/
!/kdeglobals
# KDE color schemes, symlinked into ~/.local/share/color-schemes/
!/color-schemes/
# Cursor theme source; build.py installs it into ~/.local/share/icons/Hyrule
!/hyrule-cursor/
!/kcminputrc

# A yay build checkout, not config
/hypr/yay/

# Explicitly exclude known non-customization/state directories (redundant with /*, but kept for clarity)
/Antigravity IDE/
/dconf/
/gh/
/matplotlib/
/mozilla/
/pulse/
/session/

# Within whitelisted directories, ignore backup, temporary, and state files
*.bak
*.swp
*~
*.log
*.tdb
cookie
__pycache__/
